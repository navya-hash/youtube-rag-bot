# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL=postgresql://user:password@localhost:5432/youtube_rag_db?sslmode=require

# Vector Database (Qdrant Cloud or Local)
QDRANT_URL=https://your-qdrant-instance.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=youtube_transcripts_multilingual

# Cache & Message Broker (Upstash Redis / Local Redis)
REDIS_URL=rediss://default:your_redis_token@your-redis-endpoint.upstash.io:6379

# Authentication (Clerk)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# LLM Inference (Groq)
GROQ_API_KEY=gsk_placeholder
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CLASSIFIER_MODEL=openai/gpt-oss-20b

# Embeddings (FastEmbed / Sentence-Transformers)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384

# Application Settings
APP_NAME="YouTube RAG Bot API"
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
